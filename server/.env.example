# Copy this file to .env and paste your real key.
# .env is git-ignored; .env.example is safe to commit.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Falls back to gpt-6-astra when unset; set to gpt-5 to match the slides.
# Note: gpt-6-astra does not accept a custom temperature and needs the Responses
# API for tool calling.
OPENAI_MODEL=gpt-6-astra

# Lesson 49: read by mcp-server.js to back the search_web tool.
# Get it from https://serpapi.com/ : Dashboard -> Api Key.
# Free plan is 250 searches per month (~8/day) and non-commercial, and every
# question asked through the UI spends one, so leave this empty to keep the
# web-search half switched off -- the app then answers from the PDF only and
# says so instead of failing.
SERPAPI_KEY=

# Optional. How many search results the tool asks for (default 5).
SERPAPI_NUM=5

# Optional. Deadline for one MCP tool call (default 30000 ms).
MCP_TIMEOUT_MS=30000
