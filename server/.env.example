# Copy this file to .env and paste your real key(s).
# .env is git-ignored; .env.example is safe to commit.
#
# ===========================================================================
# MODEL PROVIDERS -- the fallback chain (server/llm.js)
#
# Every model call walks down an ordered list of providers. The first one that
# answers wins; if it fails in a way that is worth retrying (bad key, no credit,
# rate limit, network, 5xx) the next one is tried automatically. So the app
# keeps answering questions after the OpenAI key runs out -- that is the whole
# point of the chain.
#
# The free entries below were picked because they ask for NO CREDIT CARD and are
# reachable from mainland China (phone or WeChat signup, no foreign number):
#
#   1. openai      paid, the original. Works exactly as before.
#   2. zhipu       FREE forever: glm-4.7-flash, 200K context, tool calling.
#                  The best first fallback -- genuinely free, not a trial.
#   3. siliconflow free tier (Qwen3-8B and friends), 30 req/min, tool calling.
#   4. dashscope   Alibaba Bailian: 1M free tokens PER MODEL for 90 days.
#   5. ollama      runs on your own machine, no key at all. Opt-in.
#
# Every provider speaks the OpenAI wire protocol, which is why swapping one in
# is a matter of a base URL and a key rather than a second SDK.
#
# A blank key simply removes that provider from the chain -- you do not have to
# fill in all of them, and OpenAI alone still works.
#
# To see what the app currently believes it has (and which entries are benched
# after a failure):
#   curl -H "x-client-id: <any-uuid>" http://localhost:5001/llm/providers
# ===========================================================================

# --- 1. OpenAI (paid) ------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Falls back to gpt-6-astra when unset; set to gpt-5 to match the slides.
# Note: gpt-6-astra does not accept a custom temperature and needs the Responses
# API for tool calling.
OPENAI_MODEL=gpt-6-astra

# --- 2-4. Free fallbacks. No credit card, no foreign phone number. ---------
# 智谱 Zhipu: https://open.bigmodel.cn  -> API keys (手机号/微信注册即可).
# glm-4.7-flash is free with no token cap; it is rate-limited to 1 concurrent
# request, which is fine here because this app serves one user at a time.
ZHIPU_API_KEY=

# 硅基流动 SiliconFlow: https://cloud.siliconflow.cn -> API keys (手机号注册).
# Free tier is rate-limited (~30 req/min), not credit-limited.
SILICONFLOW_API_KEY=

# 阿里百炼 Alibaba Bailian: https://bailian.console.aliyun.com -> API-KEY.
# Needs an Alibaba account with real-name verification. The free grant is per
# model and expires 90 days after you claim it, so this is the one that will
# eventually stop being free -- which is exactly why it sits below Zhipu.
DASHSCOPE_API_KEY=

# --- 5. Ollama (local, no key at all) --------------------------------------
# Uncomment OLLAMA_MODEL to opt in. Nothing else has to change: llm.js will not
# call it unless you ask, because it cannot tell whether the daemon is running
# without spending a request on finding out.
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Optional per-provider overrides ---------------------------------------
# Point one of these at a company gateway or a local proxy without editing code.
# OPENAI_BASE_URL=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small
# ZHIPU_EMBED_MODEL=embedding-3
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
# DASHSCOPE_EMBED_MODEL=text-embedding-v3

# --- Optional: reorder or shorten the chain --------------------------------
# A provider left out of the list is disabled without deleting its key.
# LLM_PROVIDER_ORDER=openai,zhipu,siliconflow,dashscope,ollama
# "Never spend money, ever": drop OpenAI off the front.
# LLM_PROVIDER_ORDER=zhipu,siliconflow,dashscope

# Optional: embeddings need their own chain, because a different set of models
# produces them. The trailing "local" is NOT a provider -- it is a built-in
# hash-based embedder that needs no network at all, so a PDF can always be
# indexed even with every key dead. Its retrieval quality is worse than a real
# model, so treat it as a last resort rather than a default. Set it alone
# (EMBEDDING_PROVIDER_ORDER=local) to work offline; that is also what the tests
# use, since it makes the embedding half deterministic.
# EMBEDDING_PROVIDER_ORDER=openai,dashscope,siliconflow,zhipu,ollama,local
# LOCAL_EMBED_DIMENSIONS=512

# Optional: how long a provider is benched after a failure, per failure kind.
# Benches are tracked per (capability, provider) pair, so an exhausted
# *embedding* quota does not also take that provider's chat model out of
# service -- they are billed separately and fail separately.
# LLM_AUTH_COOLDOWN_MS=600000        # bad key / model no longer exists: 10 min
# LLM_QUOTA_COOLDOWN_MS=1800000      # out of credit: 30 min
# LLM_RATE_LIMIT_COOLDOWN_MS=20000   # HTTP 429: 20 s
# LLM_NETWORK_COOLDOWN_MS=30000      # DNS / TLS / timeout / 5xx: 30 s

# ===========================================================================
# Lesson 49: web search (read by mcp-server.js to back the search_web tool)
# ===========================================================================
# Get it from https://serpapi.com/ : Dashboard -> Api Key.
# Free plan is 250 searches per month (~8/day) and non-commercial, and every
# question asked through the UI spends one, so leave this empty to keep the
# web-search half switched off -- the app then answers from the PDF only and
# says so instead of failing.
SERPAPI_KEY=

# Optional. How many search results the tool asks for (default 5).
SERPAPI_NUM=5

# Optional. Deadline for one MCP tool call (default 30000 ms).
MCP_TIMEOUT_MS=30000

# ===========================================================================
# Lesson 51: the daily assistant (daily.js)
# ===========================================================================

# Optional. The zone in which "08:00" is interpreted when a client does not name
# one (default Asia/Shanghai). Never the server's local time: this project is
# written in Shanghai and will likely be deployed in us-east-2, which is the
# entire difference between a morning message and one at 3am.
DAILY_TIMEZONE=Asia/Shanghai

# Optional. How late a missed message may still be sent (default 120 minutes).
# Without a window, a server that was down all day comes up at 23:40 and sends a
# cheerful morning briefing. 0 means "only if the tick lands in the same minute".
DAILY_CATCH_UP_MINUTES=120

# Optional. How often the in-process timer wakes up (default 60000 ms). It is
# idempotent, so this is a latency knob, not a rate knob.
DAILY_TICK_MS=60000

# Optional. Deadline for one message generation (default 120000 ms). Without one,
# a model call that never returns blocks the tick forever and every later tick
# reports "already running" -- a stalled message becomes a stalled scheduler.
DAILY_GENERATE_TIMEOUT_MS=120000

# Optional. Set to "off" to disable the in-process timer entirely, which is what
# you want once an external scheduler is calling POST /daily/tick instead.
# DAILY_SCHEDULER=off

# Optional but strongly recommended whenever the server is reachable from
# anywhere but your own machine. POST /daily/tick sends messages, and it is
# mounted *before* the x-client-id check, so this token is its only lock. Unset,
# the route accepts loopback callers only and refuses everyone else with a 503.
DAILY_TICK_TOKEN=

# Optional. Guardrails: how many subscriptions one client may have (default 5),
# how many messages are kept per client (default 30), and how many past messages
# are shown to the model so it can avoid repeating itself (default 1).
DAILY_MAX_SUBSCRIPTIONS=5
DAILY_MAX_MESSAGES=30
DAILY_HISTORY=1

# Optional. Where subscriptions and the inbox are persisted (default
# data/daily.json, relative to server/). Point a test at a scratch file so it
# cannot clobber the inbox you actually care about.
# DAILY_DATA_FILE=

# Optional. Agent loop guardrails used by /chat-agent and the daily assistant:
# max model rounds per question, max paid searches per question, chunks per
# document lookup. (Defaults: 3, 2, 4.)
AGENT_MAX_ROUNDS=3
AGENT_MAX_WEB_SEARCHES=2
AGENT_DOC_CHUNKS=4

# ===========================================================================
# Optional: server
# ===========================================================================
# Port the API listens on (default 5001; the CRA dev server proxies to it).
# PORT=5001

# Where uploaded PDFs are written, and the root DELETE /documents/:docId prunes
# from. Point it at /tmp in a container with an ephemeral filesystem.
# UPLOAD_ROOT=uploads
