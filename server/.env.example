# Copy this file to .env and paste your real key.
# .env is git-ignored; .env.example is safe to commit.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Falls back to gpt-6-astra when unset; set to gpt-5 to match the slides.
# Note: gpt-6-astra does not accept a custom temperature and needs the Responses
# API for tool calling.
OPENAI_MODEL=gpt-6-astra

# Lesson 48 does not read this yet -- it is the key the next lesson's web-search
# tool will use. Get it from https://serpapi.com/ (free plan, 250 searches/month,
# non-commercial) : Dashboard -> Api Key.
SERPAPI_KEY=
