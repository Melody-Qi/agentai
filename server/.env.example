# Copy this file to .env and paste your real key.
# .env is git-ignored; .env.example is safe to commit.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Falls back to gpt-6-astra when unset; set to gpt-5 to match the slides.
# Note: gpt-6-astra does not accept a custom temperature and needs the Responses
# API for tool calling.
OPENAI_MODEL=gpt-6-astra

# Lesson 49: read by mcp-server.js to back the search_web tool.
# Get it from https://serpapi.com/ : Dashboard -> Api Key.
# Free plan is 250 searches per month (~8/day) and non-commercial, and every
# question asked through the UI spends one, so leave this empty to keep the
# web-search half switched off -- the app then answers from the PDF only and
# says so instead of failing.
SERPAPI_KEY=

# Optional. How many search results the tool asks for (default 5).
SERPAPI_NUM=5

# Optional. Deadline for one MCP tool call (default 30000 ms).
MCP_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Lesson 51: the daily assistant (daily.js)
# ---------------------------------------------------------------------------

# Optional. The zone in which "08:00" is interpreted when a client does not name
# one (default Asia/Shanghai). Never the server's local time: this project is
# written in Shanghai and will likely be deployed in us-east-2, which is the
# entire difference between a morning message and one at 3am.
DAILY_TIMEZONE=Asia/Shanghai

# Optional. How late a missed message may still be sent (default 120 minutes).
# Without a window, a server that was down all day comes up at 23:40 and sends a
# cheerful morning briefing. 0 means "only if the tick lands in the same minute".
DAILY_CATCH_UP_MINUTES=120

# Optional. How often the in-process timer wakes up (default 60000 ms). It is
# idempotent, so this is a latency knob, not a rate knob.
DAILY_TICK_MS=60000

# Optional. Deadline for one message generation (default 120000 ms). Without one,
# a model call that never returns blocks the tick forever and every later tick
# reports "already running" -- a stalled message becomes a stalled scheduler.
DAILY_GENERATE_TIMEOUT_MS=120000

# Optional. Set to "off" to disable the in-process timer entirely, which is what
# you want once an external scheduler is calling POST /daily/tick instead.
# DAILY_SCHEDULER=off

# Optional but strongly recommended whenever the server is reachable from
# anywhere but your own machine. POST /daily/tick sends messages, and it is
# mounted *before* the x-client-id check, so this token is its only lock. Unset,
# the route accepts loopback callers only and refuses everyone else with a 503.
DAILY_TICK_TOKEN=

# Optional. Guardrails: how many subscriptions one client may have (default 5),
# how many messages are kept per client (default 30), and how many past messages
# are shown to the model so it can avoid repeating itself (default 1).
DAILY_MAX_SUBSCRIPTIONS=5
DAILY_MAX_MESSAGES=30
DAILY_HISTORY=1

# Optional. Agent loop guardrails used by /chat-agent and the daily assistant:
# max model rounds per question, max paid searches per question, chunks per
# document lookup. (Defaults: 3, 2, 4.)
AGENT_MAX_ROUNDS=3
AGENT_MAX_WEB_SEARCHES=2
AGENT_DOC_CHUNKS=4
