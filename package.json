{
  "name": "agentai",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "antd": "^6.6.3",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-scripts": "5.0.1",
    "react-speech-recognition": "^3.10.0",
    "speak-tts": "^2.0.8",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "cd server && npm run start",
    "dev": "concurrently --kill-others-on-fail \"npm start\" \"npm run server\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(react-markdown|unified|bail|trough|is-plain-obj|zwitch|longest-streak|ccount|markdown-table|stringify-entities|trim-lines|devlop|web-namespaces|property-information|space-separated-tokens|comma-separated-tokens|html-void-elements|html-url-attributes|decode-named-character-reference|character-entities|character-entities-legacy|character-entities-html4|character-reference-invalid|vfile|vfile-message|unist-.*|micromark.*|mdast-.*|hast-.*|remark-.*|rehype-.*|estree-util-.*)/).+\\.(js|mjs|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^@rc-component/(pagination|picker)/(generate|locale)/(.*)$": "<rootDir>/node_modules/@rc-component/$1/lib/$2/$3",
      "^@rc-component/(pagination|picker)/(generate|locale)$": "<rootDir>/node_modules/@rc-component/$1/lib/$2",
      "^@ant-design/colors/(?:es|esm)/(.*)$": "<rootDir>/node_modules/@ant-design/colors/lib/$1",
      "^unist-util-visit-parents/do-not-use-color$": "<rootDir>/node_modules/unist-util-visit-parents/lib/color.js",
      "^#minpath$": "<rootDir>/node_modules/vfile/lib/minpath.js",
      "^#minproc$": "<rootDir>/node_modules/vfile/lib/minproc.js",
      "^#minurl$": "<rootDir>/node_modules/vfile/lib/minurl.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
